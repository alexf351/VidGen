.env
runs/
.venv/
__pycache__/
*.pyc
# generated character reference sheets reused across runs
characters_cache/
# machine-specific settings and keys (see config.local.example.yaml)
config.local.yaml

# Skill sources kept for reference; large placeholder media stays out of git
skills/**/*.m4a
# your character library (pictures and descriptions you made in the UI)
library/
# shared node packages for the Claude Code engine (npm install happens once, here)
cache/
# your own app screenshots (added in the UI or dropped in by hand)
assets/screens/mine/
# your own music tracks (added in the UI or dropped in by hand)
assets/music/
